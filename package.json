{
  "name": "axiom-workbench",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Axiom — inspectable computational mathematics workbench",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:electron": "node scripts/build-electron.mjs && ELECTRON_START_URL=http://127.0.0.1:5173 node scripts/launch-electron.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "npm run build && node scripts/launch-electron.mjs",
    "start:quick": "node scripts/launch-electron.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "katex": "^0.19.1",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.0.2",
    "electron": "39.8.10",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vite": "7.1.5",
    "vitest": "^5.0.5"
  },
  "productName": "Axiom",
  "engines": {
    "node": ">=20.19"
  }
}
